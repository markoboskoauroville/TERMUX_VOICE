#!/bin/bash
# phonesay [--from "Mac · session"] ... | keys|update nothing|pixel|both  |  phonesay nothing|pixel|both [hr|en] "text"   |   phonesay status | log nothing|pixel
# Sends TEXT to the voice daemon on the phone (POST /say); the phone renders and speaks it itself.
ipof(){ case "$1" in nothing) echo 100.67.149.40;; pixel) echo 100.70.23.53;; *) echo "$1";; esac; }
ADB=~/Library/Android/sdk/platform-tools/adb
LANGSAY=~/Developer/claude-code/tools/langsay
FROM="Mac${PHONESAY_SESSION:+ · $PHONESAY_SESSION}"
if [ "$1" = --from ]; then FROM=$2; shift 2; fi
if [ "$1" = status ]; then
  for n in nothing pixel; do
    printf '%s: ' $n; curl -s -m 3 http://$(ipof $n):8840/health || printf 'no answer'; echo
  done; exit 0
fi
if [ "$1" = log ]; then curl -s -m 3 http://$(ipof "$2"):8840/log | python3 -c 'import sys,json;print("\n".join(json.load(sys.stdin)["log"]))'; exit 0; fi
if [ "$1" = keys ] || [ "$1" = update ]; then
  cmd=$1; who=${2:-both}; case $who in both) targets="nothing pixel";; *) targets=$who;; esac
  for t in $targets; do
    ip=$(ipof $t)
    if [ $cmd = keys ]; then
      # keys by shape (sk_...), through stdin, never in argv or on screen
      r=$(grep -o -E 'sk_[A-Za-z0-9_-]{40,}' ~/Downloads/API/speechify_api.txt | curl -s -m 5 -X POST --data-binary @- http://$ip:8840/keys)
    else
      r=$(curl -s -m 25 -X POST http://$ip:8840/update)
    fi
    echo "$t: ${r:-no answer}"
  done; exit 0
fi
[ $# -ge 2 ] || { echo 'usage: phonesay nothing|pixel|both [hr|en] "text" | status | log <phone>' >&2; exit 2; }
who=$1; shift; lang=en
case $1 in hr|en) [ $# -ge 2 ] && { lang=$1; shift; };; esac
text="$*"
case $who in both) targets="nothing pixel";; *) targets=$who;; esac
json=$(python3 -c 'import json,sys;print(json.dumps({"text":sys.argv[1],"lang":sys.argv[2],"from":sys.argv[3]}))' "$text" "$lang" "$FROM")
dev(){ case "$1" in nothing) echo "Nothing Phone";; pixel) echo "Pixel 7";; *) echo "$1";; esac; }
for t in $targets; do
  ip=$(ipof $t)
  if curl -s -m 3 -f -X POST -H 'Content-Type: application/json' -d "$json" http://$ip:8840/say >/dev/null; then
    echo "$t: said by voiced"
    if [ "$who" = both ]; then   # tell the other phone who speaks where (small line, ten seconds)
      for o in $targets; do [ $o = $t ] || curl -s -m 2 -X POST -d "$(python3 -c 'import json,sys;print(json.dumps({"device":sys.argv[1],"from":sys.argv[2]}))' "$(dev $t)" "$FROM")" http://$(ipof $o):8840/now >/dev/null; done
    fi
  else
    echo "phonesay: $t daemon did not answer, falling back to adb (mp3 rendered on the Mac)" >&2
    f=$(mktemp -t phonesay).mp3
    "$LANGSAY" --out "$f" $lang "$text" >/dev/null || { echo "phonesay: langsay failed" >&2; rm -f "$f"; continue; }
    n=phonesay_$$.mp3
    $ADB -s $ip:5555 push "$f" /sdcard/Download/$n >/dev/null &&
    $ADB -s $ip:5555 shell am start -a android.intent.action.VIEW -d file:///sdcard/Download/$n -t audio/mpeg >/dev/null && echo "$t: adb fallback"
    rm -f "$f"
  fi
done
